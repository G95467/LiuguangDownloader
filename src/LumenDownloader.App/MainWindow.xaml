<Window x:Class="LumenDownloader.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="流光下载器"
        Width="1280"
        Height="840"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Display, Microsoft YaHei UI, Microsoft YaHei"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged"
        SourceInitialized="Window_SourceInitialized">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="7"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#070A10" />
        <SolidColorBrush x:Key="TitleLeftBrush" Color="#0A0E16" />
        <SolidColorBrush x:Key="TitleMainBrush" Color="#070A10" />
        <SolidColorBrush x:Key="TitleForegroundBrush" Color="#EDF3FF" />
        <SolidColorBrush x:Key="TitleMutedBrush" Color="#627086" />
        <SolidColorBrush x:Key="TitleBorderBrush" Color="#1A2434" />
        <SolidColorBrush x:Key="TitleButtonHoverBrush" Color="#16FFFFFF" />
        <SolidColorBrush x:Key="TitleButtonPressedBrush" Color="#0DFFFFFF" />
        <SolidColorBrush x:Key="CloseHoverBrush" Color="#E5484D" />
        <SolidColorBrush x:Key="FreeBadgeBackgroundBrush" Color="#121B29" />
        <SolidColorBrush x:Key="FreeBadgeBorderBrush" Color="#223047" />
        <SolidColorBrush x:Key="FreeBadgeForegroundBrush" Color="#7E8EA8" />
        <SolidColorBrush x:Key="LoadingBackgroundBrush" Color="#070A10" />
        <SolidColorBrush x:Key="LoadingTitleBrush" Color="#EDF3FF" />
        <SolidColorBrush x:Key="LoadingMutedBrush" Color="#6A788E" />
        <SolidColorBrush x:Key="LoadingTrackBrush" Color="#16202F" />
        <SolidColorBrush x:Key="LoadingPulseBrush" Color="#5DD8FF" />

        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TitleForegroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="500" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HoverSurface"
                                Background="Transparent"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverSurface"
                                        Property="Background"
                                        Value="{DynamicResource TitleButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverSurface"
                                        Property="Background"
                                        Value="{DynamicResource TitleButtonPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource WindowControlButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HoverSurface"
                                Background="Transparent"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverSurface"
                                        Property="Background"
                                        Value="{DynamicResource CloseHoverBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverSurface"
                                        Property="Background"
                                        Value="#C63C43" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom chrome: the strip mirrors the CSS sidebar and canvas colours. -->
        <Grid x:Name="TitleBar"
              Grid.Row="0"
              Background="{DynamicResource TitleMainBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource TitleLeftBrush}"
                    IsHitTestVisible="False" />

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0"
                        IsHitTestVisible="False">
                <Border Width="26"
                        Height="26"
                        CornerRadius="8"
                        Background="#0A0F1C">
                    <Image Source="assets/icon-64.png"
                           Width="26"
                           Height="26"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <TextBlock Text="流光下载器"
                           Margin="9,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TitleForegroundBrush}"
                           TextOptions.TextRenderingMode="ClearType" />
                <Border Margin="8,0,0,0"
                        Padding="5,2,5,2"
                        VerticalAlignment="Center"
                        CornerRadius="4"
                        Background="{DynamicResource FreeBadgeBackgroundBrush}"
                        BorderBrush="{DynamicResource FreeBadgeBorderBrush}"
                        BorderThickness="1">
                    <TextBlock Text="F R E E"
                               FontSize="7.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource FreeBadgeForegroundBrush}" />
                </Border>
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Text="HTTP / HTTPS  ·  多线程直连引擎"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="9.5"
                       Foreground="{DynamicResource TitleMutedBrush}"
                       IsHitTestVisible="False" />

            <Rectangle Grid.Column="0"
                       Width="1"
                       HorizontalAlignment="Right"
                       Margin="0,12,0,12"
                       Fill="{DynamicResource TitleBorderBrush}"
                       IsHitTestVisible="False" />

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Background="{DynamicResource TitleMainBrush}">
                <Button x:Name="MinimizeButton"
                        Style="{StaticResource WindowControlButtonStyle}"
                        ToolTip="最小化"
                        Click="MinimizeButton_Click">
                    <Path Data="M 0,5 L 10,5"
                          Width="10"
                          Height="10"
                          Stretch="None"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.1"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                </Button>
                <Button x:Name="MaximizeButton"
                        Style="{StaticResource WindowControlButtonStyle}"
                        ToolTip="最大化"
                        Click="MaximizeButton_Click">
                    <Grid Width="10" Height="10">
                        <Path x:Name="MaximizeGlyph"
                              Data="M 0.5,0.5 H 9.5 V 9.5 H 0.5 Z"
                              Stretch="Fill"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.05" />
                        <Path x:Name="RestoreGlyph"
                              Data="M 2.5,2.5 H 9.5 V 9.5 H 2.5 Z M 0.5,0.5 H 7.5 V 7.5 H 0.5 Z"
                              Stretch="Fill"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.05"
                              Visibility="Collapsed" />
                    </Grid>
                </Button>
                <Button x:Name="CloseButton"
                        Style="{StaticResource CloseButtonStyle}"
                        ToolTip="关闭"
                        Click="CloseButton_Click">
                    <Path Data="M 0.5,0.5 L 9.5,9.5 M 9.5,0.5 L 0.5,9.5"
                          Width="10"
                          Height="10"
                          Stretch="None"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.1"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                </Button>
            </StackPanel>

            <Border Grid.ColumnSpan="3"
                    Height="1"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource TitleBorderBrush}"
                    IsHitTestVisible="False" />
        </Grid>

        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="WebView"
                          Visibility="Hidden"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ZoomFactor="1" />

            <Grid x:Name="LoadingOverlay">
                <Grid.Background>
                    <RadialGradientBrush Center="0.76,0.08"
                                         GradientOrigin="0.76,0.08"
                                         RadiusX="0.7"
                                         RadiusY="0.9">
                        <GradientStop Color="#182647" Offset="0" />
                        <GradientStop Color="#070A10" Offset="0.68" />
                    </RadialGradientBrush>
                </Grid.Background>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Width="380">
                    <Border Width="88"
                            Height="88"
                            CornerRadius="24"
                            HorizontalAlignment="Center"
                            Background="#0B1220"
                            BorderBrush="#1E2B42"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="42"
                                              ShadowDepth="0"
                                              Opacity="0.34"
                                              Color="#3B8FFF" />
                        </Border.Effect>
                        <Image Source="assets/icon-256.png"
                               Width="88"
                               Height="88"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>

                    <TextBlock Text="流光下载器"
                               Margin="0,25,0,0"
                               HorizontalAlignment="Center"
                               FontSize="23"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource LoadingTitleBrush}" />

                    <TextBlock Text="正在点亮界面，准备极速引擎…"
                               Margin="0,7,0,0"
                               HorizontalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource LoadingMutedBrush}" />

                    <Border Width="190"
                            Height="3"
                            Margin="0,25,0,0"
                            CornerRadius="2"
                            ClipToBounds="True"
                            Background="{DynamicResource LoadingTrackBrush}">
                        <Border x:Name="LoadingPulse"
                                Width="58"
                                Height="3"
                                HorizontalAlignment="Left"
                                CornerRadius="2"
                                Background="{DynamicResource LoadingPulseBrush}">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="LoadingPulseTransform" X="-58" />
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12"
                                                  ShadowDepth="0"
                                                  Opacity="0.6"
                                                  Color="#58D6FF" />
                            </Border.Effect>
                        </Border>
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,30,0,0">
                        <TextBlock Text="多线程分段"
                                   FontSize="9.5"
                                   Foreground="{DynamicResource LoadingMutedBrush}" />
                        <TextBlock Text="·"
                                   Margin="9,0"
                                   FontSize="9.5"
                                   Foreground="#37445A" />
                        <TextBlock Text="断点续传"
                                   FontSize="9.5"
                                   Foreground="{DynamicResource LoadingMutedBrush}" />
                        <TextBlock Text="·"
                                   Margin="9,0"
                                   FontSize="9.5"
                                   Foreground="#37445A" />
                        <TextBlock Text="完全免费"
                                   FontSize="9.5"
                                   Foreground="{DynamicResource LoadingMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="L U M E N   E N G I N E   ·   H T T P / H T T P S"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,22"
                           FontSize="7.5"
                           Foreground="{DynamicResource LoadingMutedBrush}"
                           Opacity="0.62" />
            </Grid>
        </Grid>
    </Grid>
</Window>
